# Konfigurasi Backend Kantor MMA Production
PORT=3000
NODE_ENV=development

# Database PostgreSQL lokal
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kantor_mma

# Provider AI (Gemini / OpenAI / Groq / Ollama)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_gemini_api_key_here

# Token Media Sosial (Tahap 5)
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here
TIKTOK_ACCESS_TOKEN=your_tiktok_token_here
YOUTUBE_API_KEY=your_youtube_api_key_here
